# Server Configuration
PORT=8000
HOST=0.0.0.0

# Security (JWT)
SECRET_KEY=placement_twin_ai_super_secret_key_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default to SQLite local file, but can be switched to PostgreSQL
# SQLite: sqlite:///./placement_twin.db
# PostgreSQL: postgresql://username:password@localhost:5432/placement_twin
DATABASE_URL=sqlite:///./placement_twin.db

# LLM Providers Configuration
# Supported providers: openai, groq
PRIMARY_LLM_PROVIDER=openai

# OpenAI Keys (used if provider is openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Groq Keys (used if provider is groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama3-70b-8192

# Vector Database (ChromaDB) Configuration
CHROMA_DB_DIR=./data/chromadb
KNOWLEDGE_SOURCES_DIR=./knowledge_sources
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
